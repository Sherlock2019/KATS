# KATS RAG backend — every value here has a working default.
# Copy to rag/.env only if you need to change one; start.sh sources it if present.

# --- database ----------------------------------------------------------------
POSTGRES_DB=kats_rag
POSTGRES_USER=kats
POSTGRES_PASSWORD=kats_password
POSTGRES_PORT=5433
KATS_DATABASE_URL=postgresql://kats:kats_password@127.0.0.1:5433/kats_rag

# --- api ---------------------------------------------------------------------
KATS_API_HOST=127.0.0.1
KATS_API_PORT=8001
# Comma-separated. "*" is fine on a laptop and wrong anywhere else.
KATS_CORS_ORIGINS=*

# --- local models (Ollama) ---------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Generation. Any Ollama chat model works; if this one is not installed the
# backend falls back to whatever is, and says so in /health.
#
#   phi3         2.2 GB   the default — ~1 min per grounded answer on CPU
#   gemma3:4b    ~3 GB    similar size, needs a pull
#   gemma2:9b    5.4 GB   stronger, noticeably slower
#   gemma4       9.6 GB   best reasoning, SEVERAL MINUTES per answer on CPU
#
# On a CPU-only laptop the difference is not subtle. phi3 is the default so the
# chat box is usable; switch up when you have a GPU or can wait.
KATS_LLM_MODEL=phi3

# Retrieval. NOT the same model as above — a chat model cannot embed.
# embeddinggemma is 621 MB and 768-dim, which is what rag/db/init.sql declares.
# Changing this to a different dimension means editing that column and
# re-embedding every row; the backend refuses to start on a mismatch.
KATS_EMBED_MODEL=embeddinggemma
KATS_EMBED_DIM=768

# Context window handed to the model. 8192 fits ~8 evidence chunks plus the
# system prompt; raise it only if you also raise top_k.
KATS_NUM_CTX=8192
KATS_MAX_TOKENS=1024
KATS_LLM_TIMEOUT=300
