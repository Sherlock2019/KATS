# KT AI Support — every value has a working default.
# Copy to kt-ai-support/.env only to change one.

# --- database ----------------------------------------------------------------
POSTGRES_DB=kt_ai_support
POSTGRES_USER=kt
POSTGRES_PASSWORD=kt_password
POSTGRES_PORT=5434
DATABASE_URL=postgresql://kt:kt_password@127.0.0.1:5434/kt_ai_support
DB_ECHO=false

# --- embeddings --------------------------------------------------------------
# The provider is pluggable; nothing in the business logic names a vendor.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=embeddinggemma
OLLAMA_URL=http://127.0.0.1:11434

# The dimension is NOT hardcoded in the schema — migrations/run.py substitutes
# it into the vector column. Changing it is a real migration: every stored
# vector becomes incomparable, so the runner refuses to apply a schema that
# disagrees with a populated column, and tells you to re-embed instead.
#   embeddinggemma      768
#   nomic-embed-text    768
#   mxbai-embed-large  1024
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16

# --- local llm ---------------------------------------------------------------
LLM_PROVIDER=ollama
# phi3 (2.2 GB) is the CPU default. gemma4 reasons better and takes minutes
# per answer on the same hardware — a real trade, not a tuning bug.
LLM_MODEL=phi3
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_S=300
LLM_KEEP_ALIVE=30m

# --- retrieval ---------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_POOL=60
RETRIEVAL_MAX_CHUNK_CHARS=1200

# Score weights, as JSON. Omit to use the defaults in app/config.py.
# These are a hypothesis about what matters; the evaluation suite exists to
# test it rather than assume it. Compare vector-only vs hybrid vs hybrid+KT
# by changing this and re-running the eval.
# RETRIEVAL_WEIGHTS={"semantic":0.40,"keyword":0.20,"metadata":0.15,"error_signature":0.10,"knowledge_quality":0.10,"root_cause_confidence":0.05,"kt_match":0.30}

# --- api ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8100
# "*" is right for a laptop and wrong for anything else.
CORS_ORIGINS=*
LOG_LEVEL=INFO
