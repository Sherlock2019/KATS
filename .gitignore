# ============================================================================
# NEVER PUBLISH — real customer data
# Saved production ticket pages containing a real account, bastion IPs,
# credential-vault references and named individuals' emails and phone numbers.
# ============================================================================
currentsupport.html
currentsupport_backup.html
currentsupport_files/

# Windows NTFS alternate data streams surfaced by the WSL mount.
# The colon means "*.Zone.Identifier" does NOT match these — the glob needs the colon.
*:Zone.Identifier
*Zone.Identifier

